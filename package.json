  "type": "module",
  "bugs": {
    "url": "https://github.com/systemslibrarian/TruePad/issues"
  },
  "homepage": "https://github.com/systemslibrarian/TruePad#readme",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.6.0",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
