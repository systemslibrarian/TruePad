{
  "name": "truepad",
  "version": "0.1.0",
  "description": "TruePad \u2014 a true one-time pad exhibit, the honest sibling of DeckBook",
  "bin": {
    "truepad-pad": "bin/truepad-pad.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cli.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cli": "node bin/truepad-pad.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemslibrarian/TruePad.git"
  },
  "keywords": [
    "cryptography",
    "education",
    "one-time-pad",
    "cipher",
    "shannon"
  ],
  "author": "",
