<?xml version="1.0" encoding="utf-8"?>
<!--
  The -v26 qualifier reads as redundant at minSdk 26 and lint says so
  (ObsoleteSdkInt), but AAPT2 does not resolve mipmap/ic_launcher from a bare
  `mipmap-anydpi` folder — the build fails outright. The qualifier stays, and the
  check is suppressed in build.gradle.kts with this as the reason.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
